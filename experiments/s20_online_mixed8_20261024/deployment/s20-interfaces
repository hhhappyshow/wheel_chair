#!/usr/bin/env bash
set -eo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f /opt/ros/humble/setup.bash ]]; then source /opt/ros/humble/setup.bash; fi
if [[ -f /home/hku_reconova/RoboticArm-master/install/local_setup.bash ]]; then
  source /home/hku_reconova/RoboticArm-master/install/local_setup.bash
fi
export LD_LIBRARY_PATH="/home/hku_reconova/librealsense_dds/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export ROS_DOMAIN_ID=7
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
if [[ ${1:-} == camera-session ]]; then
  shift
  exec python3 "$root/camera_session.py" "$@"
fi
if [[ ${1:-} == capture ]]; then
  shift
  exec python3 "$root/ros_observation_bridge.py" "$@"
fi
if [[ ${1:-} == observe ]]; then
  shift
  exec python3 "$root/observe_current.py" "$@"
fi
if [[ ${1:-} == run-native-cycle ]]; then
  shift
  exec python3 "$root/native_cycle_bridge.py" "$@"
fi
if [[ ${1:-} == run-cycle ]]; then
  shift
  exec python3 "$root/ros_cycle_bridge.py" "$@"
fi
exec python3 "$root/jetson_interfaces.py" "$@"
