#!/usr/bin/env bash
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd -- "$here/../../.." && pwd)"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export PYTHONPATH="$root/experiments/s20_online_mixed8_20261024:$root/experiments/s20_greedy_async_20261023${PYTHONPATH:+:$PYTHONPATH}"
case "${1:-}" in
  candidates)
    shift
    exec python3 "$here/planning_candidates.py" "$@"
    ;;
  contract|snapshot|inverse-kinematics|camera-status|camera-profiles|camera-session|capture|observe|prepare-reference|run-cycle|run-native-cycle)
    exec "$here/s20-interfaces" "$@"
    ;;
  *)
    printf '%s\n' 'Usage: s20-device {candidates|contract|snapshot|camera-status|camera-profiles|capture|prepare-reference} [arguments]' >&2
    printf '%s\n' 'run-cycle is read-only unless --execute is explicitly supplied; execution sends motion and vacuum IO.' >&2
    exit 2
    ;;
esac
