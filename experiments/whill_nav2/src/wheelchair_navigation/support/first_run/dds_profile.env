# Both sensor and navigation launchers load this file. Change together only.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_DOMAIN_ID=0
export ROS_LOCALHOST_ONLY=0
DDS_RMW_LIBRARY="/opt/ros/humble/lib/lib${RMW_IMPLEMENTATION}.so"
if [[ "$RMW_IMPLEMENTATION" == rmw_cyclonedds_cpp && ! -f "$DDS_RMW_LIBRARY" ]]; then
  DDS_LOCAL=/home/whill/Shaki_ws/dds_eval_20261030/stage/opt/ros/humble
  DDS_RMW_LIBRARY="$DDS_LOCAL/lib/librmw_cyclonedds_cpp.so"
  export LD_LIBRARY_PATH="$DDS_LOCAL/lib:$DDS_LOCAL/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH:-}"
fi
