#!/usr/bin/env python3
"""Short entry for the current S20 session; old script paths remain valid."""
import json
import os
from pathlib import Path
import sys
from datetime import datetime
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parent
DEPLOYMENT = ROOT / 'experiments/s20_online_mixed8_20261024/deployment'
sys.path.insert(0, str(DEPLOYMENT))
from current_profile import load_profile


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('help', '-h', '--help'):
        print('S20 current entry\n'
              '  ./s20 run --execute       Run four supervised hardware cycles\n'
              '  ./s20 plan --observation PATH   Plan from a recorded input; no hardware\n'
              '  ./s20 config              Show current values\n'
              '  ./s20 run --help          Show all session options\n'
              'Logs: experiments/s20_online_mixed8_20261024/runs/\n'
              'Guide: records/S20/README.md')
        return 0
    action, *extra = args
    config = load_profile()
    if action == 'config':
        print(json.dumps(config, indent=2))
        return 0
    if action not in ('run', 'plan'):
        raise SystemExit('Use ./s20 help')
    help_requested = any(v in extra for v in ('--help', '-h'))
    if action == 'run' and '--execute' not in extra and not help_requested:
        raise SystemExit('Hardware motion requires explicit ./s20 run --execute')
    if action == 'plan' and '--execute' in extra:
        raise SystemExit('plan does not execute hardware; use run explicitly')
    if action == 'plan' and not any(v == '--observation' or v.startswith('--observation=') for v in extra) and not help_requested:
        raise SystemExit('Provide --observation PATH for offline planning')
    defaults = []
    for name, value in config['launch'].items():
        defaults += ['--'+name.replace('_', '-'), str(value)]
    stamp = datetime.now(ZoneInfo('Asia/Shanghai')).strftime('%Y%m%d_%H%M%S_%f')
    output = ROOT / 'experiments/s20_online_mixed8_20261024/runs' / f'{action}_{stamp}'
    command = [str(ROOT / 'reproductions/nvidia_curobo_v2_20261023/.venv/bin/python'),
               str(DEPLOYMENT / 'online_session.py'), *defaults, '--output', str(output), *extra]
    os.chdir(ROOT)
    os.execv(command[0], command)


if __name__ == '__main__':
    raise SystemExit(main())
