# Sourced only by the isolated simulation launchers, never the real stack.
source /home/whill/Shaki_ws/src/WheelChair_ws/first_run/dds_profile.env
export ROS_DOMAIN_ID=198 ROS_LOCALHOST_ONLY=1 RMW_IMPLEMENTATION="${SIM_RMW:-rmw_fastrtps_cpp}"
if [[ "$RMW_IMPLEMENTATION" == rmw_cyclonedds_cpp ]]; then
  export CYCLONEDDS_URI='<CycloneDDS><Domain><Discovery><ParticipantIndex>auto</ParticipantIndex><MaxAutoParticipantIndex>40</MaxAutoParticipantIndex></Discovery></Domain></CycloneDDS>'
fi
